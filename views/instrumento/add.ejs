<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Cadastrar Instrumento</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <h1>Cadastrar Instrumento</h1>

  <nav>
    <a href="/instrumento/lst">Voltar à listagem</a>
  </nav>

  <form action="/instrumento/add" method="POST">
    <label for="nome">Nome</label>
    <input type="text" id="nome" name="nome" required>

    <label for="fabricante">Fabricante</label>
    <input type="text" id="fabricante" name="fabricante" required>

    <label for="preco">Preço (R$)</label>
    <input type="number" id="preco" name="preco" step="0.01" min="0" required>

    <label for="tipo">Tipo</label>
    <input type="text" id="tipo" name="tipo" placeholder="Ex.: Corda, Percussão, Sopro, Teclas" required>

    <button type="submit">Cadastrar</button>
  </form>
</body>
</html>
